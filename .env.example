# Copy to .env for local development. Render sets these from render.yaml / its dashboard.
DEBUG=true
SECRET_KEY=change-me
# Leave empty locally to use SQLite; Render provides a PostgreSQL URL.
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin account created/ensured by `python manage.py setup_roles`
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Optional AI feedback (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Days without activity before an unfinished topic counts as "stopped halfway"
ABANDON_AFTER_DAYS=3
